    "test:e2e": "playwright test",
    "images:variants": "tsx scripts/image-variants.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tiptap/extension-color": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "highlight.js": "^11.11.1",
    "image-size": "^2.1.0",
    "marked": "^18.1.3",
    "next": "16.4.6",
    "nodemailer": "^10.4.0",
    "prisma": "^7.10.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "effect": "3.22.4"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
