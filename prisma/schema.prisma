generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  color       String     @default("#6366f1")
  order       Int        @default(0)
  linkUrl     String?
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  tutorials   Tutorial[]
  createdAt   DateTime   @default(now())

  @@index([parentId, order])
}

model Tutorial {
  id         Int                @id @default(autoincrement())
  title      String
  slug       String             @unique
  excerpt    String?
  content    String
  /// 后台上传的封面图（/uploads/…），文章页头图与分享卡片使用
  cover      String?
  /// 列表卡片缩略图：封面，没有封面时取正文第一张上传图片（优先 400w 小图）；保存时计算
  thumbnail  String?
  published  Boolean            @default(false)
  /// 定时发布时间：未发布且到了这个时间，由后台定时任务自动发布（lib/scheduled-publish.ts）
  publishAt  DateTime?
  views      Int                @default(0)
  categoryId Int
  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags       TutorialTag[]
  revisions  TutorialRevision[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([categoryId])
  @@index([published, createdAt])
  // 分类列表、上一篇/下一篇、各分类已发布篇数
  @@index([published, categoryId, createdAt])
  // sitemap（覆盖索引：只读索引不回表）
  @@index([published, updatedAt, slug])
  // 后台教程列表按最近修改排序
  @@index([updatedAt])
  // 定时发布任务：找到期的草稿
  @@index([published, publishAt])
}

/// 教程的历史版本：每次保存前把旧内容存一份（每篇最多保留 30 个），可在后台查看和恢复。
model TutorialRevision {
  id         Int      @id @default(autoincrement())
  tutorialId Int
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title      String
  excerpt    String?
  content    String
  /// 这个版本当初保存的时间
  savedAt    DateTime
  /// 用新内容替换掉这个版本的管理员
  replacedBy String?
  createdAt  DateTime @default(now())

  @@index([tutorialId, savedAt])
}

model Admin {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  password      String
  /// Base32 TOTP secret, encrypted at rest (lib/secret-box.mjs); null means two-factor authentication is off.
  totpSecret    String?
  /// Last accepted TOTP time step, so a code cannot be replayed.
  totpLastStep  Int?
  createdAt     DateTime            @default(now())
  sessions      AdminSession[]
  passkeys      AdminPasskey[]
  recoveryCodes AdminRecoveryCode[]
}

/// 教程标签（与分类互补：一篇教程只属于一个分类，但可以有多个标签）。
model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  /// URL 别名：小写，非字母数字转成连字符（见 lib/tags.ts 的 tagSlug）
  slug      String        @unique
  createdAt DateTime      @default(now())
  tutorials TutorialTag[]
}

model TutorialTag {
  tutorialId Int
  tagId      Int
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  /// 作者填写的顺序（第一个通常最重要）
  position   Int      @default(0)

  @@id([tutorialId, tagId])
  @@index([tagId])
}

/// 两步验证的一次性恢复码（只存 SHA-256），用掉即删除。
model AdminRecoveryCode {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime @default(now())

  @@unique([adminId, codeHash])
}

/// WebAuthn 通行密钥（指纹 / 面容 / 手机 / 安全密钥）。只存公钥，私钥不离开用户设备。
model AdminPasskey {
  /// Credential ID（base64url）
  id         String    @id
  adminId    Int
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  /// 签名计数器，用于发现被克隆的认证器
  counter    Int       @default(0)
  /// 逗号分隔的 transports（internal、hybrid、usb…）
  transports String?
  name       String
  /// 是否为可同步的密钥（如 iCloud 钥匙串、Google 密码管理器）
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([adminId])
}

/// Server-side session record: logging out or revoking deletes the row,
/// so a copied cookie stops working immediately.
model AdminSession {
  id        String   @id
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

/// Append-only security/audit trail for admin activity.
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actor     String?
  ip        String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
