generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  color       String     @default("#6366f1")
  order       Int        @default(0)
  linkUrl     String?
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  tutorials   Tutorial[]
  createdAt   DateTime   @default(now())

  @@index([parentId, order])
}

model Tutorial {
  id               Int                 @id @default(autoincrement())
  title            String
  slug             String              @unique
  excerpt          String?
  content          String
  /// 后台上传的封面图（/uploads/…），文章页头图与分享卡片使用
  cover            String?
  /// 列表卡片缩略图：封面，没有封面时取正文第一张上传图片（优先 400w 小图）；保存时计算
  thumbnail        String?
  published        Boolean             @default(false)
  /// 定时发布时间：未发布且到了这个时间，由后台定时任务自动发布（lib/scheduled-publish.ts）
  publishAt        DateTime?
  views            Int                 @default(0)
  /// 读者在文末点的「有帮助 / 没帮助」次数（原生 SQL 自增，不刷新 updatedAt）
  helpfulYes       Int                 @default(0)
  helpfulNo        Int                 @default(0)
  /// 所属系列与在系列里的顺序（从 1 开始）；不属于任何系列时为空
  seriesId         Int?
  series           Series?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder      Int                 @default(0)
  /// 系列里的章节名：相邻、同名的几篇归为一章（lib/series.ts 的 groupByChapter），空表示不分章
  seriesChapter    String?
  dailyViews       TutorialDailyView[]
  feedbackMessages FeedbackMessage[]
  /// 已经给订阅者发过「新教程」邮件的时间；每篇只发一次（撤回再发布不会重发）
  notifiedAt       DateTime?
  categoryId       Int
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// 作者（后台账号）；账号被删除时由删除它的站长接手（lib/actions/users.ts），外键兜底置空
  authorId         Int?
  author           Admin?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags             TutorialTag[]
  revisions        TutorialRevision[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([published, createdAt])
  // 分类列表、上一篇/下一篇、各分类已发布篇数
  @@index([published, categoryId, createdAt])
  // sitemap（覆盖索引：只读索引不回表）
  @@index([published, updatedAt, slug])
  // 后台教程列表按最近修改排序
  @@index([updatedAt])
  // 定时发布任务：找到期的草稿
  @@index([published, publishAt])
  // 系列目录
  @@index([seriesId, seriesOrder])
}

/// 教程系列：几篇教程按顺序组成一组（如「从零搭建博客」第 1–5 篇），文章页显示系列目录。
model Series {
  id          Int        @id @default(autoincrement())
  title       String
  /// URL 别名：/series/<slug>
  slug        String     @unique
  description String?
  tutorials   Tutorial[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// 每篇教程每天的阅读量（仪表盘的 30 天趋势和热门文章），day 是北京时间的 YYYY-MM-DD。
model TutorialDailyView {
  tutorialId  Int
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  day         String
  views       Int      @default(0)
  /// 读到正文末尾的次数（停留 10 秒以上才算），读完率 = completions / views
  completions Int      @default(0)

  @@id([tutorialId, day])
  @@index([day])
}

/// 每天的搜索词统计（仪表盘看热门搜索和「没找到」的搜索）。query 已规整：小写、合并空白、最多 100 字。
model SearchQueryDaily {
  day     String
  query   String
  count   Int    @default(0)
  /// 最近一次搜索的结果数，0 表示没找到
  results Int    @default(0)

  @@id([day, query])
  @@index([day])
}

/// 每天的阅读来源：source 是来源网站的域名，或 (direct) 直接访问、(internal) 站内跳转。
model ReferrerDaily {
  day    String
  source String
  views  Int    @default(0)

  @@id([day, source])
  @@index([day])
}

/// 读者点「没帮助」之后留下的话，只在后台可见。
model FeedbackMessage {
  id         Int      @id @default(autoincrement())
  tutorialId Int
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read, createdAt])
  @@index([tutorialId])
}

/// 教程的历史版本：每次保存前把旧内容存一份（每篇最多保留 30 个），可在后台查看和恢复。
model TutorialRevision {
  id         Int      @id @default(autoincrement())
  tutorialId Int
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  title      String
  excerpt    String?
  content    String
  /// 这个版本当初保存的时间
  savedAt    DateTime
  /// 用新内容替换掉这个版本的管理员
  replacedBy String?
  createdAt  DateTime @default(now())

  @@index([tutorialId, savedAt])
}

model Admin {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  password      String
  /// Base32 TOTP secret, encrypted at rest (lib/secret-box.mjs); null means two-factor authentication is off.
  totpSecret    String?
  /// Last accepted TOTP time step, so a code cannot be replayed.
  totpLastStep  Int?
  /// 角色：owner 站长 / editor 编辑 / author 作者（权限见 lib/roles.ts）。新账号默认权限最小的作者
  role          String              @default("author")
  /// 文章页显示的作者署名；为空时不显示署名（不公开登录用户名）
  displayName   String?
  createdAt     DateTime            @default(now())
  tutorials     Tutorial[]
  sessions      AdminSession[]
  passkeys      AdminPasskey[]
  recoveryCodes AdminRecoveryCode[]
}

/// 教程标签（与分类互补：一篇教程只属于一个分类，但可以有多个标签）。
model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  /// URL 别名：小写，非字母数字转成连字符（见 lib/tags.ts 的 tagSlug）
  slug      String        @unique
  createdAt DateTime      @default(now())
  tutorials TutorialTag[]
}

model TutorialTag {
  tutorialId Int
  tagId      Int
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  /// 作者填写的顺序（第一个通常最重要）
  position   Int      @default(0)

  @@id([tutorialId, tagId])
  @@index([tagId])
}

/// 两步验证的一次性恢复码（只存 SHA-256），用掉即删除。
model AdminRecoveryCode {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime @default(now())

  @@unique([adminId, codeHash])
}

/// WebAuthn 通行密钥（指纹 / 面容 / 手机 / 安全密钥）。只存公钥，私钥不离开用户设备。
model AdminPasskey {
  /// Credential ID（base64url）
  id         String    @id
  adminId    Int
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  /// 签名计数器，用于发现被克隆的认证器
  counter    Int       @default(0)
  /// 逗号分隔的 transports（internal、hybrid、usb…）
  transports String?
  name       String
  /// 是否为可同步的密钥（如 iCloud 钥匙串、Google 密码管理器）
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([adminId])
}

/// Server-side session record: logging out or revoking deletes the row,
/// so a copied cookie stops working immediately.
model AdminSession {
  id        String   @id
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

/// Append-only security/audit trail for admin activity.
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actor     String?
  ip        String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 邮件订阅者：点了确认邮件里的链接才算订阅（confirmedAt），退订即删除整行。
model Subscriber {
  id            Int       @id @default(autoincrement())
  /// 小写、去掉首尾空白
  email         String    @unique
  confirmedAt   DateTime?
  /// 最近一次发确认邮件的时间：同一地址 10 分钟内不重发，免得被拿来给别人刷邮件
  confirmSentAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([confirmedAt])
}
