generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  color       String     @default("#6366f1")
  order       Int        @default(0)
  linkUrl     String?
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  tutorials   Tutorial[]
  createdAt   DateTime   @default(now())

  @@index([parentId, order])
}

model Tutorial {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  cover      String?
  published  Boolean  @default(false)
  views      Int      @default(0)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([published, createdAt])
  // 分类列表、上一篇/下一篇、各分类已发布篇数
  @@index([published, categoryId, createdAt])
  // sitemap（覆盖索引：只读索引不回表）
  @@index([published, updatedAt, slug])
  // 后台教程列表按最近修改排序
  @@index([updatedAt])
}

model Admin {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  password      String
  /// Base32 TOTP secret, encrypted at rest (lib/secret-box.mjs); null means two-factor authentication is off.
  totpSecret    String?
  /// Last accepted TOTP time step, so a code cannot be replayed.
  totpLastStep  Int?
  createdAt     DateTime            @default(now())
  sessions      AdminSession[]
  passkeys      AdminPasskey[]
  recoveryCodes AdminRecoveryCode[]
}

/// 两步验证的一次性恢复码（只存 SHA-256），用掉即删除。
model AdminRecoveryCode {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime @default(now())

  @@unique([adminId, codeHash])
}

/// WebAuthn 通行密钥（指纹 / 面容 / 手机 / 安全密钥）。只存公钥，私钥不离开用户设备。
model AdminPasskey {
  /// Credential ID（base64url）
  id         String    @id
  adminId    Int
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  /// 签名计数器，用于发现被克隆的认证器
  counter    Int       @default(0)
  /// 逗号分隔的 transports（internal、hybrid、usb…）
  transports String?
  name       String
  /// 是否为可同步的密钥（如 iCloud 钥匙串、Google 密码管理器）
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([adminId])
}

/// Server-side session record: logging out or revoking deletes the row,
/// so a copied cookie stops working immediately.
model AdminSession {
  id        String   @id
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

/// Append-only security/audit trail for admin activity.
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actor     String?
  ip        String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
